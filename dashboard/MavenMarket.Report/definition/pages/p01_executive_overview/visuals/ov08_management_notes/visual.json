    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Management notes (full period, 1997–1998)",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Network revenue grew 112.2% in 1998; comparable-store revenue grew 8.4%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Gross margin (59.7%) is set by fixed product prices and costs; it moves only with product mix.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The top 10% of active customers generated 39.9% of revenue.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Return rate (proxy) stayed near 1.0% of units sold.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Store size alone does not explain revenue; review productivity by store.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#334155"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
