	partition DimCustomer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				        {"customer_key", Int64.Type},
				        {"customer_id", Int64.Type},
				        {"customer_acct_num", type text},
				        {"customer_full_name", type text},
				        {"first_name", type text},
				        {"last_name", type text},
				        {"last_name_missing", type logical},
				        {"customer_city", type text},
				        {"customer_state_province", type text},
				        {"customer_postal_code", type text},
				        {"customer_country", type text},
				        {"birthdate", type date},
				        {"birth_year", Int64.Type},
				        {"marital_status", type text},
				        {"yearly_income", type text},
				        {"gender", type text},
				        {"total_children", Int64.Type},
				        {"num_children_at_home", Int64.Type},
				        {"education", type text},
				        {"acct_open_date", type date},
				        {"account_open_year", Int64.Type},
				        {"member_card", type text},
				        {"occupation", type text},
				        {"is_homeowner", type logical}
				        },
				        "en-US"
				    ),
				    Added1 = Table.AddColumn(ChangedTypes, "member_card_sort", each if [member_card] = "Normal" then 1 else if [member_card] = "Bronze" then 2 else if [member_card] = "Silver" then 3 else if [member_card] = "Golden" then 4 else 5, Int64.Type),
				    Added2 = Table.AddColumn(Added1, "income_band_sort", each Number.From(Text.BetweenDelimiters([yearly_income], "$", "K")), Int64.Type)
				in
				    Added2

	annotation PBI_ResultType = Table

