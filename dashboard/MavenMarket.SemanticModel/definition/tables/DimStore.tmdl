	partition DimStore = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_store.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				        {"store_key", Int64.Type},
				        {"store_id", Int64.Type},
				        {"store_name", type text},
				        {"store_type", type text},
				        {"store_city", type text},
				        {"store_state", type text},
				        {"store_country", type text},
				        {"first_opened_date", type date},
				        {"last_remodel_date", type date},
				        {"total_sqft", Int64.Type},
				        {"grocery_sqft", Int64.Type},
				        {"non_grocery_sqft", Int64.Type},
				        {"grocery_share_pct", type number},
				        {"region_id", Int64.Type},
				        {"sales_district", type text},
				        {"sales_region", type text},
				        {"is_same_store_comparable", type logical}
				        },
				        "en-US"
				    )
				in
				    ChangedTypes

