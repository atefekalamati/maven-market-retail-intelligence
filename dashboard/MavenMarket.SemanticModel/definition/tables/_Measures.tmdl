		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 02 Time Intelligence
		lineageTag: 2439cf95-99da-5db5-b92f-fe6a0ce068ea

	measure 'Gross Profit MoM Growth %' =
			DIVIDE(
			    [Gross Product Profit] - [Gross Profit Previous Month],
			    [Gross Profit Previous Month]
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Time Intelligence
		lineageTag: 0a2a6351-0824-5b2f-b9c5-f5d8032c4ebf

	measure 'Revenue Running Total' =
			CALCULATE(
			    [Total Revenue],
			    FILTER(
			        ALLSELECTED(DimDate[date]),
			        DimDate[date] <= MAX(DimDate[date])
			    )
			)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 02 Time Intelligence
		lineageTag: 124aa3c8-2397-5e51-b9a6-57acecfbbbcf

	measure 'Store Revenue Rank' =
			RANKX(
			    ALLSELECTED(DimStore[store_name]),
			    [Total Revenue],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 05 Store
		lineageTag: d6dfd736-28b4-5313-a3bf-98155879c9d4

	measure 'Product Revenue Rank' =
			RANKX(
			    ALLSELECTED(DimProduct[product_name]),
			    [Total Revenue],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 04 Product
		lineageTag: 9e5be439-380b-5739-b7ad-17b46df60758

	measure 'Brand Profit Rank' =
			RANKX(
			    ALLSELECTED(DimProduct[product_brand]),
			    [Gross Product Profit],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 04 Product
		lineageTag: 92eb7b05-8168-5675-a3bc-35c104275457

	measure 'Return Rate vs Overall (pp)' =
			VAR OverallRate =
			    CALCULATE(
			        [Return Quantity Rate %],
			        REMOVEFILTERS(DimStore),
			        REMOVEFILTERS(DimProduct)
			    )
			RETURN
			    ([Return Quantity Rate %] - OverallRate) * 100
		formatString: +0.00;-0.00;0.00
		displayFolder: 06 Returns
		lineageTag: f8cd98a0-d350-5e56-8d1c-df8f141c31f4

	measure 'Selected Date Range' =
			VAR StartDate = MIN(DimDate[date])
			VAR EndDate = MAX(DimDate[date])
			RETURN
			    FORMAT(StartDate, "MMM d, yyyy")
			        & " – "
			        & FORMAT(EndDate, "MMM d, yyyy")
		displayFolder: 07 Display
		lineageTag: 594e8630-4676-569f-aad1-f2f8f6e91f0c

	measure 'Selected Geography' =
			VAR CountryCount = COUNTROWS(VALUES(DimStore[store_country]))
			VAR RegionCount = COUNTROWS(VALUES(DimStore[sales_region]))
			RETURN
			    SWITCH(
			        TRUE(),
			        HASONEVALUE(DimStore[store_name]), SELECTEDVALUE(DimStore[store_name]),
			        HASONEVALUE(DimStore[sales_region]), SELECTEDVALUE(DimStore[sales_region]),
			        HASONEVALUE(DimStore[store_country]), SELECTEDVALUE(DimStore[store_country]),
			        CountryCount > 1 || RegionCount > 1, "All selected locations",
			        "All locations"
			    )
		displayFolder: 07 Display
		lineageTag: 5a93da0b-c1de-52a8-ab1f-1fb8d4c0649f

	measure 'Executive Page Subtitle' =
			[Selected Date Range]
			    & "  |  "
			    & [Selected Geography]
		displayFolder: 07 Display
		lineageTag: a1b989e6-8a5b-5494-9f5e-778b69de03c3

	measure 'Visible Store Count' =
			DISTINCTCOUNT(FactSales[store_key])
		formatString: #,0
		displayFolder: 05 Store
		lineageTag: ed414cf3-fb64-5f34-a302-f4592443ccc1

	measure 'Visible Product Count' =
			DISTINCTCOUNT(FactSales[product_key])
		formatString: #,0
		displayFolder: 04 Product
		lineageTag: 9848951b-efa6-5b0c-afb5-389be5d8233b

	measure 'Visible Customer Count' =
			DISTINCTCOUNT(FactSales[customer_key])
		formatString: #,0
		displayFolder: 03 Customer
		lineageTag: 13373d93-b8df-5d53-b47d-b2c27bb09950

	measure 'Latest Year Revenue Growth %' =
			VAR LatestYear = MAX(DimDate[year])
			RETURN
			    CALCULATE([Revenue Growth %], DimDate[year] = LatestYear)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Time Intelligence
		lineageTag: f293b4c5-d131-557a-b28d-2a0c3e6183f9

	measure 'Latest Year Same-Store Revenue Growth %' =
			VAR LatestYear = MAX(DimDate[year])
			RETURN
			    CALCULATE([Same-Store Revenue Growth %], DimDate[year] = LatestYear)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Time Intelligence
		lineageTag: 2682867f-bb66-513e-ba2e-0d5c5c5792eb

	measure 'Reported Growth Label' =
			IF(
			    ISBLANK([Latest Year Revenue Growth %]),
			    "No prior-year comparison",
			    FORMAT([Latest Year Revenue Growth %], "+0.0%;-0.0%;0.0%")
			)
		displayFolder: 07 Display
		lineageTag: fd28a93a-83bc-5f7d-b260-01ca74bf663f

	measure 'Same-Store Growth Label' =
			IF(
			    ISBLANK([Latest Year Same-Store Revenue Growth %]),
			    "No comparable-store baseline",
			    FORMAT([Latest Year Same-Store Revenue Growth %], "+0.0%;-0.0%;0.0%")
			)
		displayFolder: 07 Display
		lineageTag: 876418df-42ea-5561-b00c-fbf7f491d717

	measure 'Comparable Stores' =
			CALCULATE(
			    [Active Stores],
			    KEEPFILTERS(DimStore[is_same_store_comparable] = TRUE())
			)
		formatString: #,0
		displayFolder: 05 Store
		lineageTag: 9fce2db4-405c-57cb-b981-97917a171143

	measure 'Return Lines' =
			COUNTROWS(FactReturns)
		formatString: #,0
		displayFolder: 06 Returns
		lineageTag: ca86b029-00a0-53c5-bf80-d6c5e25a47e1

	measure 'Returned Products' =
			DISTINCTCOUNT(FactReturns[product_key])
		formatString: #,0
		displayFolder: 06 Returns
		lineageTag: ed7f991d-1f46-5c21-88c1-67b49cb8d02e

	measure 'Product Return Rate (300+ Units) %' =
			IF(
			    [Quantity Sold] >= 300,
			    [Return Quantity Rate %]
			)
		formatString: 0.0%
		displayFolder: 06 Returns
		lineageTag: c1a26fc4-7d96-5439-b494-0075edcb053d

	measure 'Cumulative Customer Revenue Share %' =
			VAR Percentile = SELECTEDVALUE(CustomerPercentile[Customer Percentile])
			VAR CustomerRevenue =
			    ADDCOLUMNS(
			        VALUES(FactSales[customer_key]),
			        "@Revenue", CALCULATE([Total Revenue])
			    )
			VAR CustomerCount = COUNTROWS(CustomerRevenue)
			VAR TopCustomerCount = ROUNDUP(CustomerCount * Percentile / 100, 0)
			VAR TopRevenue =
			    SUMX(
			        TOPN(
			            TopCustomerCount,
			            CustomerRevenue,
			            [@Revenue], DESC,
			            FactSales[customer_key], ASC
			        ),
			        [@Revenue]
			    )
			RETURN
			    IF(
			        NOT ISBLANK(Percentile) && CustomerCount > 0,
			        DIVIDE(TopRevenue, SUMX(CustomerRevenue, [@Revenue]))
			    )
		formatString: 0.0%
		displayFolder: 03 Customer
		lineageTag: e3d30c4f-144b-5a1f-b051-b4ec20c7f8c0

	measure 'Return Review Flag' =
			VAR DifferencePP = [Return Rate vs Overall (pp)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Return Quantity Rate %]), "No return data",
			        DifferencePP >= 0.50, "Review",
			        DifferencePP >= 0.15, "Watch",
			        "Within network range"
			    )
		displayFolder: 06 Returns
		lineageTag: 459cacb1-df0d-58c9-bee8-4ad3b88e722b

