	partition DimProduct = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				        {"product_key", Int64.Type},
				        {"product_id", Int64.Type},
				        {"product_brand", type text},
				        {"product_name", type text},
				        {"product_sku", type text},
				        {"product_retail_price", Currency.Type},
				        {"product_cost", Currency.Type},
				        {"unit_gross_profit", Currency.Type},
				        {"unit_margin_pct", type number},
				        {"unit_markup_pct", type number},
				        {"product_weight", type number},
				        {"is_recyclable", type logical},
				        {"is_low_fat", type logical}
				        },
				        "en-US"
				    )
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

