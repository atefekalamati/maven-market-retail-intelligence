	partition DimDate = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				        {"date_key", Int64.Type},
				        {"date", type date},
				        {"year", Int64.Type},
				        {"quarter_number", Int64.Type},
				        {"quarter", type text},
				        {"month_number", Int64.Type},
				        {"month_name", type text},
				        {"month_short_name", type text},
				        {"year_month", type text},
				        {"year_month_sort", Int64.Type},
				        {"iso_week_number", Int64.Type},
				        {"day_of_month", Int64.Type},
				        {"day_name", type text},
				        {"day_of_week_number", Int64.Type},
				        {"is_weekend", type logical}
				        },
				        "en-US"
				    )
				in
				    ChangedTypes

