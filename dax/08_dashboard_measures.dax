// Stage 8 — Dashboard display and interaction measures
// These measures extend the KPI measures created in Stage 7.
// Mark DimDate[date] as the date table before using time-intelligence functions.

Revenue YTD =
TOTALYTD(
    [Total Revenue],
    DimDate[date]
)

Gross Profit YTD =
TOTALYTD(
    [Gross Product Profit],
    DimDate[date]
)

Revenue Previous Month =
CALCULATE(
    [Total Revenue],
    DATEADD(DimDate[date], -1, MONTH)
)

Revenue MoM Growth % =
DIVIDE(
    [Total Revenue] - [Revenue Previous Month],
    [Revenue Previous Month]
)

Gross Profit Previous Month =
CALCULATE(
    [Gross Product Profit],
    DATEADD(DimDate[date], -1, MONTH)
)

Gross Profit MoM Growth % =
DIVIDE(
    [Gross Product Profit] - [Gross Profit Previous Month],
    [Gross Profit Previous Month]
)

Revenue Running Total =
CALCULATE(
    [Total Revenue],
    FILTER(
        ALLSELECTED(DimDate[date]),
        DimDate[date] <= MAX(DimDate[date])
    )
)

Store Revenue Rank =
RANKX(
    ALLSELECTED(DimStore[store_name]),
    [Total Revenue],
    ,
    DESC,
    DENSE
)

Product Revenue Rank =
RANKX(
    ALLSELECTED(DimProduct[product_name]),
    [Total Revenue],
    ,
    DESC,
    DENSE
)

Brand Profit Rank =
RANKX(
    ALLSELECTED(DimProduct[product_brand]),
    [Gross Product Profit],
    ,
    DESC,
    DENSE
)

Return Rate vs Overall (pp) =
VAR OverallRate =
    CALCULATE(
        [Return Quantity Rate %],
        REMOVEFILTERS(DimStore),
        REMOVEFILTERS(DimProduct)
    )
RETURN
    ([Return Quantity Rate %] - OverallRate) * 100

Selected Date Range =
VAR StartDate = MIN(DimDate[date])
VAR EndDate = MAX(DimDate[date])
RETURN
    FORMAT(StartDate, "MMM d, yyyy")
        & " – "
        & FORMAT(EndDate, "MMM d, yyyy")

Selected Geography =
VAR CountryCount = COUNTROWS(VALUES(DimStore[store_country]))
VAR RegionCount = COUNTROWS(VALUES(DimStore[sales_region]))
RETURN
    SWITCH(
        TRUE(),
        HASONEVALUE(DimStore[store_name]), SELECTEDVALUE(DimStore[store_name]),
        HASONEVALUE(DimStore[sales_region]), SELECTEDVALUE(DimStore[sales_region]),
        HASONEVALUE(DimStore[store_country]), SELECTEDVALUE(DimStore[store_country]),
        CountryCount > 1 || RegionCount > 1, "All selected locations",
        "All locations"
    )

Executive Page Subtitle =
[Selected Date Range]
    & "  |  "
    & [Selected Geography]

Visible Store Count =
DISTINCTCOUNT(FactSales[store_key])

Visible Product Count =
DISTINCTCOUNT(FactSales[product_key])

Visible Customer Count =
DISTINCTCOUNT(FactSales[customer_key])

// Growth for the latest selected year. Without a year filter, the Stage 7
// growth measures compare 1997-1998 with 1996-1997, which is not a valid
// year-over-year comparison, so KPI cards use these measures instead.
Latest Year Revenue Growth % =
VAR LatestYear = MAX(DimDate[year])
RETURN
    CALCULATE([Revenue Growth %], DimDate[year] = LatestYear)

Latest Year Same-Store Revenue Growth % =
VAR LatestYear = MAX(DimDate[year])
RETURN
    CALCULATE([Same-Store Revenue Growth %], DimDate[year] = LatestYear)

Reported Growth Label =
IF(
    ISBLANK([Latest Year Revenue Growth %]),
    "No prior-year comparison",
    FORMAT([Latest Year Revenue Growth %], "+0.0%;-0.0%;0.0%")
)

Same-Store Growth Label =
IF(
    ISBLANK([Latest Year Same-Store Revenue Growth %]),
    "No comparable-store baseline",
    FORMAT([Latest Year Same-Store Revenue Growth %], "+0.0%;-0.0%;0.0%")
)

Comparable Stores =
CALCULATE(
    [Active Stores],
    KEEPFILTERS(DimStore[is_same_store_comparable] = TRUE())
)

Return Lines =
COUNTROWS(FactReturns)

Returned Products =
DISTINCTCOUNT(FactReturns[product_key])

// Product return rates are only shown for products with at least 300 units
// sold, so small denominators do not dominate the ranking.
Product Return Rate (300+ Units) % =
IF(
    [Quantity Sold] >= 300,
    [Return Quantity Rate %]
)

// Customer concentration curve. CustomerPercentile is a disconnected
// calculated table with the values 1-100, so the curve follows report filters.
Cumulative Customer Revenue Share % =
VAR Percentile = SELECTEDVALUE(CustomerPercentile[Customer Percentile])
VAR CustomerRevenue =
    ADDCOLUMNS(
        VALUES(FactSales[customer_key]),
        "@Revenue", CALCULATE([Total Revenue])
    )
VAR CustomerCount = COUNTROWS(CustomerRevenue)
VAR TopCustomerCount = ROUNDUP(CustomerCount * Percentile / 100, 0)
VAR TopRevenue =
    SUMX(
        TOPN(
            TopCustomerCount,
            CustomerRevenue,
            [@Revenue], DESC,
            FactSales[customer_key], ASC
        ),
        [@Revenue]
    )
RETURN
    IF(
        NOT ISBLANK(Percentile) && CustomerCount > 0,
        DIVIDE(TopRevenue, SUMX(CustomerRevenue, [@Revenue]))
    )

Return Review Flag =
VAR DifferencePP = [Return Rate vs Overall (pp)]
RETURN
    SWITCH(
        TRUE(),
        ISBLANK([Return Quantity Rate %]), "No return data",
        DifferencePP >= 0.50, "Review",
        DifferencePP >= 0.15, "Watch",
        "Within network range"
    )

// Usage notes:
// 1. The return flag is relative to the current network average, not a business target.
// 2. Store and product ranks respect the report's selected filters.
// 3. Dynamic labels are display measures and should not be used as numerical KPIs.
// 4. CustomerPercentile is a calculated table in the semantic model:
//    CustomerPercentile = SELECTCOLUMNS(GENERATESERIES(1, 100, 1), "Customer Percentile", [Value])
